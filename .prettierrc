{
  "arrowParens": "avoid",
  "singleQuote": true,
  "printWidth": 80,
  "bracketSpacing": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react",
    "^react-native$",
    "^@/test-utils/intervalsConnection$",
    "<THIRD_PARTY_MODULES>"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
