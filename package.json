{
  "name": "black-horse-cycling-app",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "env:staging": "eas env:pull --environment development && printf '\\nAPP_ENV=staging\\n' >> .env.local",
    "env:production": "eas env:pull --environment production && printf '\\nAPP_ENV=production\\n' >> .env.local",
    "ios:prebuild": "expo prebuild --clean --platform ios",
    "android:prebuild": "expo prebuild --clean --platform android",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint . --max-warnings 0",
    "test": "jest",
    "e2e:build:ios": "bash scripts/e2e-build.sh ios",
    "e2e:build:android": "bash scripts/e2e-build.sh android",
    "e2e:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON e2e/seed.ts",
    "e2e:ios": "npm run e2e:seed && E2E_TELEMETRY_DISABLED=1 e2e run --target ios",
    "e2e:android": "npm run e2e:seed && E2E_TELEMETRY_DISABLED=1 e2e run --target android",
    "icons:generate": "node ./scripts/generate-icons.js",
    "prepare": "husky",
    "worktree:link": "bash scripts/link-worktree-config.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/functions/",
      "/.claude/",
      "\\.e2e\\.ts$"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|marked|github-slugger))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "dependencies": {
    "@dev-plugins/react-query": "^0.4.0",
    "@expo/ui": "57.0.22",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "@react-native-firebase/firestore": "^24.0.0",
    "@react-native-firebase/functions": "^24.0.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/restyle": "^2.4.5",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.26",
    "expo-auth-session": "~57.0.13",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-marked": "8.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "sonner-native": "0.27.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.101.0",
    "@e2e-dev/acp": "0.1.1",
    "@e2e-dev/mobile": "0.12.6",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "^14.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "e2e": "0.23.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "jimp-compact": "^0.16.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "react-test-renderer": "^19.1.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{js,json,md}": "prettier --write"
  }
}
