{
  "cli": {
    "version": ">= 18.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "dev-client": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging"
      }
    },
    "dev": {
      "environment": "development",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "dev"
      },
      "channel": "dev",
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "environment": "development",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "staging"
      },
      "channel": "staging"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production"
      },
      "channel": "production"
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "6829009387"
      },
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
